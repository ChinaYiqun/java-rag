# Copy to .env for local reference, then export the variables in your shell.
# Java-RAG does not automatically load .env files.

# LLM and embedding provider
RAG_API_KEY=
RAG_EMBEDDING_API_URL=https://api.baichuan-ai.com/v1/embeddings
RAG_LLM_MODEL=Baichuan3-Turbo
RAG_LLM_URL=https://api.baichuan-ai.com/v1/chat/completions

# Redis
RAG_REDIS_HOST=127.0.0.1
RAG_REDIS_PORT=6379
RAG_REDIS_PASSWORD=
RAG_REDIS_EXPIRE_SECONDS=180

# Elasticsearch
RAG_ES_URL=http://127.0.0.1:9200
RAG_ES_USERNAME=elastic
RAG_ES_PASSWORD=

# Jina
RAG_JINA_API_KEY=
RAG_JINA_MULTI_VECTOR_URL=https://api.jina.ai/v1/multi-vector

# SerpAPI
RAG_SERP_API_KEY=
